# Node
node_modules/
frontend/dist/
*.log

# Go
backend/bin/
backend/configer
backend/configer-data/
*.out

# Editor / OS
.DS_Store
.vscode/
.idea/

# Local env
.env
.env.local

# TypeScript build info
*.tsbuildinfo

# Graphify knowledge graph (generated). Rebuilt fresh each session by the
# SessionStart hook - pure AST, zero tokens - so it is never committed.
graphify-out/

# Continuous Quality Platform output. Everything under .cq is regenerated by
# `cq run`: reports, raw analyzer artifacts, the result cache and the baselines.
# The baselines are deliberately NOT committed - they belong to a branch's CI
# cache, not to the repository, because a baseline in git would be rewritten by
# every merge and would silently measure the wrong thing.
.cq/
quality/bin/
